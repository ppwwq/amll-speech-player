{
  "name": "amll-speech-player",
  "version": "1.0.0",
  "description": "Local speech practice player based on HKLHaoBin/amll-web",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/package-source.mjs && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "python tests/local_session.py && python tests/file_import.py && python tests/browser.py && python tests/drag_seek.py && python tests/drag_preview.py && python tests/drag_replay.py && python tests/ui_checks.py && python tests/top_layout.py && python tests/seek_order.py && python tests/tap_playback.py"
  },
  "keywords": [
    "lyrics",
    "music",
    "player",
    "animation",
    "web",
    "typescript",
    "vite"
  ],
  "author": "BingoKingo",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/stats.js": "^0.17.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-static-copy": "^3.1.2",
    "vite-plugin-wasm": "^3.5.0"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.2.0-alpha.5",
    "@applemusic-like-lyrics/lyric": "0.2.4",
    "@applemusic-like-lyrics/ttml": "0.1.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@types/colorthief": "^2.6.0",
    "@vercel/speed-insights": "^1.2.0",
    "@wasm-audio-decoders/flac": "^0.2.8",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.18",
    "@wasm-audio-decoders/opus-ml": "^0.0.1",
    "codec-parser": "^2.5.0",
    "colorthief": "^2.6.0",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lil-gui": "^0.20.0",
    "mpg123-decoder": "^1.0.2",
    "music-metadata": "^11.9.0",
    "ogg-opus-decoder": "^1.7.1",
    "stats": "^1.0.0",
    "stats.js": "^0.17.0",
    "synaudio": "^0.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
